                        -io.Position.Z * 0.07

                    if keys[Enum.KeyCode.LeftShift]
                        and not keys[Enum.KeyCode.LeftControl] then

                        S.rightReach =
                            math.clamp(
                                S.rightReach + delta,
                                0.05,
