                local topLevel = {dpad, vert, grab, func, shakeBtn, handBtn, timeBox, gyroBtn, gyroHandBtn, gyroResetBtn, gyroSensBtn, gyroRadiusBtn, sensDownBtn, sensUpBtn, sensLabel, gyroVRBtn, gyroVRHandBtn, gyroVRHeadBtn, gyroVRHandToggleBtn, moveSmoothBtn, lookSmoothBtn, handResetBtn, waveBtn, clapBtn, startleBtn, flexBtn, throwBtn, punchBtn, blockBtn}
                for _, el in ipairs(topLevel) do
                    if el.Visible then
                        local absPos = el.AbsolutePosition
                        local absSize = el.AbsoluteSize
                        if pos.X >= absPos.X and pos.X <= absPos.X + absSize.X
                            and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y then
                            return true
                        end
                    end
                end
                return false
            end

            local touchLook = false
            local lastTouch = Vector2.zero
            local viewport = workspace.CurrentCamera.ViewportSize

            UIS.TouchStarted:Connect(function(i)
                local pos = i.Position
                local slider = findSliderAt(pos)
                if slider then
                    activeSliderTouches[i] = slider
                    if slider.track.Size.Y.Scale > slider.track.Size.X.Scale then
                        updateVerticalSlider(slider, pos)
                    else
                        updateHorizontalSlider(slider, pos)
                    end
                    return
                end
                if isInsideAnyControl(pos) then return end
                if pos.X > viewport.X * 0.5 then
                    local vpY = viewport.Y
                    if pos.Y < vpY * 0.85 and pos.Y > vpY * 0.15 then
                        touchLook = true
                        lastTouch = pos
                    end
                end
            end)

            UIS.TouchMoved:Connect(function(i)
                local slider = activeSliderTouches[i]
                if slider then
                    if slider.track.Size.Y.Scale > slider.track.Size.X.Scale then
                        updateVerticalSlider(slider, i.Position)
                    else
                        updateHorizontalSlider(slider, i.Position)
                    end
                elseif touchLook then
                    local delta = i.Position - lastTouch
                    addLookInput(delta.X, delta.Y)
                    lastTouch = i.Position
                end
            end)

            UIS.TouchEnded:Connect(function(i)
                if activeSliderTouches[i] then activeSliderTouches[i] = nil
                elseif touchLook then touchLook = false
                end
            end)
        end
    end)
    print("[NoVR] control active.")
end)
