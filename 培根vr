do
    ----------------------------------------------------------------
    -- VR Hands No-VR
    -- No-VR + Gyroscope Hand Control
    ----------------------------------------------------------------

    local qot = queue_on_teleport or (syn and syn.queue_on_teleport)

    local checks = {
        {"getrawmetatable", getrawmetatable},
        {"setreadonly", setreadonly},
        {"newcclosure", newcclosure},
        {"getnamecallmethod", getnamecallmethod},
        {"getgc", getgc},
        {"queue_on_teleport", qot},
    }

    local missing = {}
    local report = "[VR Hands No-VR] UNC test:\n"

    for _, c in ipairs(checks) do
        local ok = type(c[2]) == "function"

        report = report .. (" [%s] %s\n"):format(
            ok and "+" or "-",
            c[1]
        )

        if not ok then
            table.insert(missing, c[1])
        end
    end

    print(report)

    if #missing > 0 then
        warn(
            "[VR Hands No-VR] Missing functions: "
            .. table.concat(missing, ", ")
        )

        warn(
            "[VR Hands No-VR] Executor not supported - aborting."
        )

        return
    end

    print("[VR Hands No-VR] UNC test passed - launching.")

    ----------------------------------------------------------------
    -- Services
    ----------------------------------------------------------------

    local Players = game:GetService("Players")
    local TeleportService = game:GetService("TeleportService")
    local VRService = game:GetService("VRService")
    local UIS = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")

    local lp = Players.LocalPlayer

    ----------------------------------------------------------------
    -- Main payload
    ----------------------------------------------------------------

    local hrs = [==[

        ----------------------------------------------------------------
        -- Services
        ----------------------------------------------------------------

        local VRService = game:GetService("VRService")
        local UIS = game:GetService("UserInputService")
        local RunService = game:GetService("RunService")
        local Players = game:GetService("Players")

        local lp = Players.LocalPlayer

        local identity = CFrame.identity

        ----------------------------------------------------------------
        -- Make Roblox think VR is enabled
        ----------------------------------------------------------------

        do
            local mt = getrawmetatable(game)

            local oldIndex = mt.__index
            local oldNamecall = mt.__namecall

            setreadonly(mt, false)

            mt.__index = newcclosure(function(self, k)

                if k == "VREnabled"
                    and (self == VRService or self == UIS) then

                    return true
                end

                return oldIndex(self, k)
            end)

            mt.__namecall = newcclosure(function(self, ...)

                if self == VRService then

                    local method = getnamecallmethod()

                    if method == "GetUserCFrameEnabled" then
                        return true
                    end

                    if method == "GetUserCFrame" then
                        return identity
                    end
                end

                return oldNamecall(self, ...)
            end)

            setreadonly(mt, true)
        end

        ----------------------------------------------------------------
        -- Create expected VR folders/parts
        ----------------------------------------------------------------

        task.spawn(function()

            local function ensureFolder(parent, name)

                local folder = parent:FindFirstChild(name)

                if not folder then
                    folder = Instance.new("Folder")
                    folder.Name = name
                    folder.Parent = parent
                end

                return folder
            end

            local function ensurePart(parent, name)

                local part = parent:FindFirstChild(name)

                if not part then

                    part = Instance.new("Part")

                    part.Name = name
                    part.Anchored = true
                    part.CanCollide = false
                    part.Transparency = 1
                    part.Size = Vector3.new(1, 1, 1)

                    part.Parent = parent
                end

                return part
            end

            local function populate(cam)

                if not cam then
                    return
                end

                ensurePart(
                    ensureFolder(cam, "VRCoreEffectParts"),
                    "Cursor"
                )

                ensurePart(
                    ensureFolder(cam, "VRCorePanelParts"),
                    "BottomBar_Part"
                )
            end

            populate(workspace.CurrentCamera)

            workspace:GetPropertyChangedSignal(
                "CurrentCamera"
            ):Connect(function()

                populate(workspace.CurrentCamera)
            end)

            local t0 = os.clock()

            while os.clock() - t0 < 30 do

                populate(workspace.CurrentCamera)

                task.wait(0.1)
            end
        end)

        ----------------------------------------------------------------
        -- VR rig
        ----------------------------------------------------------------

        task.spawn(function()

            while not lp do
                task.wait()
                lp = Players.LocalPlayer
            end

            local uid = tostring(lp.UserId)

            local vrPlayers =
                workspace:WaitForChild("VRPlayers", 60)

            if not vrPlayers then
                warn("[NoVR] no VRPlayers")
                return
            end

            local rig =
                vrPlayers:WaitForChild(uid, 60)

            if not rig then
                warn("[NoVR] The server did not issue a rig")
                return
            end

            rig:WaitForChild("VRHead", 20)
            rig:WaitForChild("LeftHand", 20)
            rig:WaitForChild("RightHand", 20)

            local scaleVal =
                rig:FindFirstChild("VRScale")

            local cam = workspace.CurrentCamera

            ----------------------------------------------------------------
            -- Settings
            ----------------------------------------------------------------

            local S = {

                leftReach = 0.55,
                rightReach = 0.55,

                spread = 0.34,
                height = -0.25,

                sens = 0.005,
                moveK = 0.16,

                look = true,

                scale = 10,

                grabRadiusMult = 1,

                toggleGrabMode = false,

                speedMult = 1,

                ------------------------------------------------------------
                -- Gyroscope
                ------------------------------------------------------------

                gyroEnabled = false,

                gyroHand = "Left",

                gyroSensitivity = 1,

                gyroDeadzone = 0.01,
            }

            ----------------------------------------------------------------
            -- Input object MUST be declared before VRUtils closure
            ----------------------------------------------------------------

            local vrm
            local Input

            ----------------------------------------------------------------
            -- Hand rotations
            ----------------------------------------------------------------

            local leftAngleX = 0
            local leftAngleY = 0
            local leftAngleZ = 0

            local rightAngleX = 0
            local rightAngleY = 0
            local rightAngleZ = 0

            local headRotX = 0
            local headRotY = 0
            local headRotZ = 0

            ----------------------------------------------------------------
            -- Action timers
            ----------------------------------------------------------------

            local waveStartTime = 0
            local waveDuration = 2.5

            local clapStartTime = 0
            local clapDuration = 2

            local startleStartTime = 0
            local startleDuration = 1.5

            local flexStartTime = 0
            local flexDuration = 2

            local punchStartTime = 0
            local punchDuration = 0.5

            local blockStartTime = 0
            local blockDuration = 2

            local throwStartTime = 0
            local throwDuration = 0.4

            local throwingHand = nil
            local throwReleasePending = nil

            ----------------------------------------------------------------
            -- Shake mode
            ----------------------------------------------------------------

            local shakeMode = false
            local shakeTargetList = {}
            local shakeIndex = 0
            local shakeTargetStart = 0

            local SHAKE_DURATION = 0.5
            local SHAKE_AMP = 6.5

            local shakeBothHands = true

            ----------------------------------------------------------------
            -- Gyroscope state
            ----------------------------------------------------------------

            local gyroBase = CFrame.identity
            local gyroCurrent = CFrame.identity

            local function getDeviceRotation()

                local ok, result = pcall(function()
                    return UIS:GetDeviceRotation()
                end)

                if ok and typeof(result) == "CFrame" then
                    return result
                end

                return CFrame.identity
            end

            local function captureGyroBase()

                gyroBase = getDeviceRotation()

                gyroCurrent = CFrame.identity

                print(
                    "[NoVR] 陀螺仪中立姿态已重新校准"
                )
            end

            local function setGyroEnabled(enabled)

                S.gyroEnabled = enabled

                if enabled then
                    captureGyroBase()

                    print(
                        "[NoVR] 陀螺仪手部控制：开启，"
                        .. S.gyroHand .. "手"
                    )
                else

                    gyroCurrent = CFrame.identity

                    print(
                        "[NoVR] 陀螺仪手部控制：关闭"
                    )
                end
            end

            local function toggleGyro()

                setGyroEnabled(not S.gyroEnabled)
            end

            local function switchGyroHand()

                if S.gyroHand == "Left" then
                    S.gyroHand = "Right"
                else
                    S.gyroHand = "Left"
                end

                if S.gyroEnabled then
                    captureGyroBase()
                end

                print(
                    "[NoVR] 陀螺仪控制："
                    .. S.gyroHand .. "手"
                )
            end

            local function getGyroCFrame()

                if not S.gyroEnabled then
                    return CFrame.identity
                end

                local current =
                    getDeviceRotation()

                local relative

                pcall(function()

                    relative =
                        gyroBase:ToObjectSpace(current)
                end)

                if typeof(relative) ~= "CFrame" then
                    return CFrame.identity
                end

                local x, y, z =
                    relative:ToEulerAnglesXYZ()

                ------------------------------------------------------------
                -- Deadzone
                ------------------------------------------------------------

                if math.abs(x) < S.gyroDeadzone then
                    x = 0
                end

                if math.abs(y) < S.gyroDeadzone then
                    y = 0
                end

                if math.abs(z) < S.gyroDeadzone then
                    z = 0
                end

                x = x * S.gyroSensitivity
                y = y * S.gyroSensitivity
                z = z * S.gyroSensitivity

                return CFrame.Angles(x, y, z)
            end

            ----------------------------------------------------------------
            -- Shake functions
            ----------------------------------------------------------------

            local function getShakeTargets()

                local list = {}

                for _, p in ipairs(Players:GetPlayers()) do

                    if p ~= lp
                        and p.Character
                        and p.Character:FindFirstChild(
                            "HumanoidRootPart"
                        ) then

                        table.insert(list, p)
                    end
                end

                return list
            end

            local function startShakeMode()

                local list = getShakeTargets()

                if #list == 0 then

                    warn(
                        "[NoVR] 甩人：没有其他玩家"
                    )

                    return
                end

                shakeTargetList = list
                shakeIndex = 1
                shakeTargetStart = os.clock()

                shakeMode = true

                print(
                    ("[NoVR] 甩人开始，目标 %d 人")
                    :format(#list)
                )
            end

            local function stopShakeMode()

                shakeMode = false

                shakeTargetList = {}
                shakeIndex = 0

                print("[NoVR] 甩人停止")
            end

            ----------------------------------------------------------------
            -- VRUtils hook
            ----------------------------------------------------------------

            local ok, VRUtils = pcall(function()

                return require(
                    lp.PlayerScripts
                        .ClientLoader
                        .PlayerModule
                        .VRModule
                        .VRUtils
                )
            end)

            if ok and type(VRUtils) == "table" then

                VRUtils.GetUserCFrame =
                    function(uc, scale)

                        scale = scale or cam.HeadScale

                        if scale <= 1 then

                            scale = math.max(
                                (scaleVal
                                    and scaleVal.Value
                                    or 1) * 60,
                                6
                            )
                        end

                        local now = os.clock()

                        ----------------------------------------------------
                        -- Throw cleanup
                        ----------------------------------------------------

                        if throwingHand
                            and now - throwStartTime
                                >= throwDuration then

                            throwingHand = nil
                            throwReleasePending = nil
                        end

                        ----------------------------------------------------
                        -- LEFT HAND
                        ----------------------------------------------------

                        if uc == Enum.UserCFrame.LeftHand then

                            ------------------------------------------------
                            -- Shake mode
                            ------------------------------------------------

                            if shakeMode
                                and #shakeTargetList > 0 then

                                local target =
                                    shakeTargetList[
                                        math.clamp(
                                            shakeIndex,
                                            1,
                                            #shakeTargetList
                                        )
                                    ]

                                if target
                                    and target.Character then

                                    local hrp =
                                        target.Character:
                                            FindFirstChild(
                                                "HumanoidRootPart"
                                            )

                                    if hrp then

                                        local targetPos =
                                            hrp.Position
                                            + Vector3.new(
                                                0,
                                                1.5,
                                                0
                                            )

                                        local localOffset =
                                            cam.CFrame:
                                                PointToObjectSpace(
                                                    targetPos
                                                )

                                        local t = now

                                        local amp =
                                            SHAKE_AMP

                                        local shake =
                                            Vector3.new(

                                                math.sin(
                                                    t * 1500
                                                ) * amp,

                                                math.cos(
                                                    t * 1450
                                                ) * amp,

                                                math.sin(
                                                    t * 1600 + 1.2
                                                ) * amp
                                            )

                                        local spin =
                                            CFrame.Angles(
                                                t * 420,
                                                t * 480,
                                                t * 380
                                            )

                                        local whirl =
                                            CFrame.Angles(

                                                math.sin(
                                                    t * 900
                                                ) * 2.5,

                                                math.cos(
                                                    t * 950
                                                ) * 2.5,

                                                math.sin(
                                                    t * 1000
                                                ) * 2.5
                                            )

                                        return
                                            CFrame.new(
                                                localOffset
                                                + shake
                                                + Vector3.new(
                                                    -1.5,
                                                    0,
                                                    0
                                                )
                                            )
                                            * whirl
                                            * spin
                                    end
                                end
                            end

                            ------------------------------------------------
                            -- Normal left hand
                            ------------------------------------------------

                            local offset =
                                Vector3.new(
                                    -S.spread,
                                    S.height,
                                    -S.leftReach
                                ) * scale

                            local headRot =
                                CFrame.Angles(
                                    math.rad(headRotX),
                                    math.rad(headRotY),
                                    math.rad(headRotZ)
                                )

                            local basePos =
                                (
                                    headRot
                                    * CFrame.new(offset)
                                ).Position

                            local rot =
                                CFrame.Angles(
                                    math.rad(leftAngleX),
                                    math.rad(leftAngleY),
                                    math.rad(leftAngleZ)
                                )

                            ------------------------------------------------
                            -- Throw
                            ------------------------------------------------

                            if throwingHand == "left" then

                                local t =
                                    now - throwStartTime

                                local maxOffset =
                                    0.8 * scale

                                local force

                                if t < throwDuration / 2 then

                                    force =
                                        (
                                            t
                                            / (throwDuration / 2)
                                        )
                                        * maxOffset

                                else

                                    force =
                                        (
                                            1
                                            - (
                                                t
                                                - throwDuration / 2
                                            )
                                            / (throwDuration / 2)
                                        )
                                        * maxOffset
                                end

                                basePos =
                                    basePos
                                    + cam.CFrame.LookVector
                                    * force

                                if throwReleasePending == "left"
                                    and t > 0.02 then

                                    if Input then

                                        Input.lFist = 0
                                        Input.lIndex = 0

                                    end

                                    throwReleasePending = nil
                                end
                            end

                            ------------------------------------------------
                            -- Wave
                            ------------------------------------------------

                            if now - waveStartTime
                                < waveDuration then

                                local t =
                                    now - waveStartTime

                                rot =
                                    rot
                                    * CFrame.Angles(
                                        math.sin(t * 12) * 0.6,
                                        0,
                                        0
                                    )
                            end

                            ------------------------------------------------
                            -- Clap
                            ------------------------------------------------

                            if now - clapStartTime
                                < clapDuration then

                                local t =
                                    now - clapStartTime

                                basePos =
                                    basePos
                                    + Vector3.new(
                                        math.sin(t * 25)
                                        * 0.15
                                        * scale,
                                        0,
                                        0
                                    )
                            end

                            ------------------------------------------------
                            -- Startle
                            ------------------------------------------------

                            if now - startleStartTime
                                < startleDuration then

                                local t =
                                    now - startleStartTime

                                local shake =
                                    math.sin(t * 30)
                                    * 0.08
                                    * scale

                                basePos =
                                    basePos
                                    + Vector3.new(
                                        -0.3 * scale
                                            + shake,
                                        shake,
                                        shake
                                    )

                                rot =
                                    rot
                                    * CFrame.Angles(
                                        math.sin(t * 40)
                                            * 0.2,
                                        0,
                                        0
                                    )
                            end

                            ------------------------------------------------
                            -- Block
                            ------------------------------------------------

                            if now - blockStartTime
                                < blockDuration then

                                basePos =
                                    Vector3.new(
                                        -0.15 * scale,
                                        0.2 * scale,
                                        0.1 * scale
                                    )

                                rot =
                                    CFrame.Angles(
                                        0,
                                        math.rad(30),
                                        math.rad(-20)
                                    )
                            end

                            ------------------------------------------------
                            -- Gyroscope LEFT
                            ------------------------------------------------

                            if S.gyroEnabled
                                and S.gyroHand == "Left" then

                                rot =
                                    rot
                                    * getGyroCFrame()
                            end

                            return
                                CFrame.new(basePos)
                                * rot
                        end

                        ----------------------------------------------------
                        -- RIGHT HAND
                        ----------------------------------------------------

                        if uc == Enum.UserCFrame.RightHand then

                            ------------------------------------------------
                            -- Shake mode
                            ------------------------------------------------

                            if shakeBothHands
                                and shakeMode
                                and #shakeTargetList > 0 then

                                local target =
                                    shakeTargetList[
                                        math.clamp(
                                            shakeIndex,
                                            1,
                                            #shakeTargetList
                                        )
                                    ]

                                if target
                                    and target.Character then

                                    local hrp =
                                        target.Character:
                                            FindFirstChild(
                                                "HumanoidRootPart"
                                            )

                                    if hrp then

                                        local targetPos =
                                            hrp.Position
                                            + Vector3.new(
                                                0,
                                                1.5,
                                                0
                                            )

                                        local localOffset =
                                            cam.CFrame:
                                                PointToObjectSpace(
                                                    targetPos
                                                )

                                        local t = now

                                        local amp =
                                            SHAKE_AMP

                                        local shake =
                                            Vector3.new(

                                                math.cos(
                                                    t * 1500 + 0.7
                                                ) * amp,

                                                math.sin(
                                                    t * 1450 + 2.1
                                                ) * amp,

                                                math.cos(
                                                    t * 1600 + 3.3
                                                ) * amp
                                            )

                                        local spin =
                                            CFrame.Angles(
                                                t * 460,
                                                t * 540,
                                                t * 440
                                            )

                                        local whirl =
                                            CFrame.Angles(

                                                math.cos(
                                                    t * 950
                                                ) * 2.5,

                                                math.sin(
                                                    t * 900
                                                ) * 2.5,

                                                math.cos(
                                                    t * 1000
                                                ) * 2.5
                                            )

                                        return
                                            CFrame.new(
                                                localOffset
                                                + shake
                                                + Vector3.new(
                                                    1.5,
                                                    0,
                                                    0
                                                )
                                            )
                                            * whirl
                                            * spin
                                    end
                                end
                            end

                            ------------------------------------------------
                            -- Normal right hand
                            ------------------------------------------------

                            local offset =
                                Vector3.new(
                                    S.spread,
                                    S.height,
                                    -S.rightReach
                                ) * scale

                            local headRot =
                                CFrame.Angles(
                                    math.rad(headRotX),
                                    math.rad(headRotY),
                                    math.rad(headRotZ)
                                )

                            local basePos =
                                (
                                    headRot
                                    * CFrame.new(offset)
                                ).Position

                            local rot =
                                CFrame.Angles(
                                    math.rad(rightAngleX),
                                    math.rad(rightAngleY),
                                    math.rad(rightAngleZ)
                                )

                            ------------------------------------------------
                            -- Throw
                            ------------------------------------------------

                            if throwingHand == "right" then

                                local t =
                                    now - throwStartTime

                                local maxOffset =
                                    0.8 * scale

                                local force

                                if t < throwDuration / 2 then

                                    force =
                                        (
                                            t
                                            / (throwDuration / 2)
                                        )
                                        * maxOffset

                                else

                                    force =
                                        (
                                            1
                                            - (
                                                t
                                                - throwDuration / 2
                                            )
                                            / (throwDuration / 2)
                                        )
                                        * maxOffset
                                end

                                basePos =
                                    basePos
                                    + cam.CFrame.LookVector
                                    * force

                                if throwReleasePending == "right"
                                    and t > 0.02 then

                                    if Input then

                                        Input.rFist = 0
                                        Input.rIndex = 0

                                    end

                                    throwReleasePending = nil
                                end
                            end

                            ------------------------------------------------
                            -- Clap
                            ------------------------------------------------

                            if now - clapStartTime
                                < clapDuration then

                                local t =
                                    now - clapStartTime

                                basePos =
                                    basePos
                                    + Vector3.new(
                                        -math.sin(t * 25)
                                        * 0.15
                                        * scale,
                                        0,
                                        0
                                    )
                            end

                            ------------------------------------------------
                            -- Startle
                            ------------------------------------------------

                            if now - startleStartTime
                                < startleDuration then

                                local t =
                                    now - startleStartTime

                                local shake =
                                    math.sin(t * 30)
                                    * 0.08
                                    * scale

                                basePos =
                                    basePos
                                    + Vector3.new(
                                        0.3 * scale
                                            + shake,
                                        shake,
                                        -shake
                                    )

                                rot =
                                    rot
                                    * CFrame.Angles(
                                        math.sin(t * 40)
                                            * 0.2,
                                        0,
                                        0
                                    )
                            end

                            ------------------------------------------------
                            -- Flex
                            ------------------------------------------------

                            if now - flexStartTime
                                < flexDuration then

                                local t =
                                    now - flexStartTime

                                local flex =
                                    math.min(
                                        t / 0.3,
                                        1
                                    )

                                basePos =
                                    basePos
                                    + Vector3.new(
                                        0,
                                        0.4 * flex * scale,
                                        0.3 * flex * scale
                                    )

                                rot =
                                    rot
                                    * CFrame.Angles(
                                        math.rad(
                                            -90 * flex
                                        ),
                                        0,
                                        math.rad(
                                            -20 * flex
                                        )
                                    )
                            end

                            ------------------------------------------------
                            -- Punch
                            ------------------------------------------------

                            if now - punchStartTime
                                < punchDuration then

                                local t =
                                    now - punchStartTime

                                local forward =
                                    math.sin(t * 12)
                                    * 0.6
                                    * scale

                                basePos =
                                    basePos
                                    + Vector3.new(
                                        0,
                                        0,
                                        -forward
                                    )
                            end

                            ------------------------------------------------
                            -- Block
                            ------------------------------------------------

                            if now - blockStartTime
                                < blockDuration then

                                basePos =
                                    Vector3.new(
                                        0.15 * scale,
                                        0.2 * scale,
                                        0.1 * scale
                                    )

                                rot =
                                    CFrame.Angles(
                                        0,
                                        math.rad(-30),
                                        math.rad(20)
                                    )
                            end

                            ------------------------------------------------
                            -- Gyroscope RIGHT
                            ------------------------------------------------

                            if S.gyroEnabled
                                and S.gyroHand == "Right" then

                                rot =
                                    rot
                                    * getGyroCFrame()
                            end

                            return
                                CFrame.new(basePos)
                                * rot
                        end

                        return identity
                    end

            else

                warn(
                    "[NoVR] failed to intercept VRUtils"
                )
            end

            ----------------------------------------------------------------
            -- Find VR input
            ----------------------------------------------------------------

            for _ = 1, 250 do

                for _, o in pairs(getgc(true)) do

                    if type(o) == "table"
                        and rawget(o, "HeadsetPart") ~= nil
                        and rawget(o, "Input") ~= nil
                        and rawget(o, "CharacterScale") ~= nil
                        and rawget(o, "DataManager") ~= nil then

                        vrm = o
                        Input = rawget(o, "Input")

                        break
                    end
                end

                if Input then
                    break
                end

                for _, o in pairs(getgc(true)) do

                    if type(o) == "table"
                        and rawget(o, "directionLateral") ~= nil
                        and rawget(o, "rFist") ~= nil
                        and rawget(o, "turnDirection") ~= nil then

                        Input = o

                        break
                    end
                end

                if Input then
                    break
                end

                task.wait(0.1)
            end

            if not Input then

                warn(
                    "[NoVR] Input object not found - grip will not work"
                )
            end

            ----------------------------------------------------------------
            -- Disable original Inputs render step
            ----------------------------------------------------------------

            task.spawn(function()

                for _ = 1, 100 do

                    pcall(function()

                        RunService:UnbindFromRenderStep(
                            "Inputs"
                        )
                    end)

                    task.wait(0.1)
                end
            end)

            ----------------------------------------------------------------
            -- Grab radius
            ----------------------------------------------------------------

            pcall(function()

                if vrm and vrm.PropManager then

                    local pmMT =
                        getrawmetatable(
                            vrm.PropManager
                        )

                    if pmMT
                        and rawget(
                            pmMT,
                            "GetBestGrabPartInRadius"
                        ) then

                        local orig =
                            pmMT.GetBestGrabPartInRadius

                        setreadonly(pmMT, false)

                        pmMT.GetBestGrabPartInRadius =
                            function(
                                self,
                                root,
                                prox,
                                radius,
                                scale,
                                ...
                            )

                                local scaleComp =
                                    10
                                    / math.max(
                                        S.scale,
                                        0.1
                                    )

                                local adjustedRadius =
                                    radius
                                    * scaleComp
                                    * S.grabRadiusMult

                                return orig(
                                    self,
                                    root,
                                    prox,
                                    adjustedRadius,
                                    scale,
                                    ...
                                )
                            end

                        setreadonly(pmMT, true)
                    end
                end

                if vrm and vrm.CharacterManager then

                    local cmMT =
                        getrawmetatable(
                            vrm.CharacterManager
                        )

                    if cmMT
                        and rawget(
                            cmMT,
                            "GetClosestCharacterInRadius"
                        ) then

                        local orig =
                            cmMT.GetClosestCharacterInRadius

                        setreadonly(cmMT, false)

                        cmMT.GetClosestCharacterInRadius =
                            function(
                                self,
                                pos,
                                radius,
                                ...
                            )

                                local scaleComp =
                                    10
                                    / math.max(
                                        S.scale,
                                        0.1
                                    )

                                local adjustedRadius =
                                    radius
                                    * scaleComp
                                    * S.grabRadiusMult

                                return orig(
                                    self,
                                    pos,
                                    adjustedRadius,
                                    ...
                                )
                            end

                        setreadonly(cmMT, true)
                    end
                end
            end)

            ----------------------------------------------------------------
