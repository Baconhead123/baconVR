    RunService:BindToRenderStep("NoVR_Control", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if S.look and not UIS.TouchEnabled then
            local d = UIS:GetMouseDelta()
            if lookSmoothOn then
                lookSmoothTarget = lookSmoothTarget + d
            else
                applyLookDelta(d.X, d.Y)
            end
            UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
        end

        if lookSmoothOn and lookSmoothTarget.Magnitude > 0.001 then
            local a = 1 - math.exp(-lookSmoothRate * dt)
            local step = lookSmoothTarget * a
            lookSmoothTarget = lookSmoothTarget * (1 - a)
            if lookSmoothTarget.Magnitude < 0.05 then lookSmoothTarget = Vector2.zero end
            applyLookDelta(step.X, step.Y)
        end

        if gyroMode and gyroNow then
            if not gyroBase then gyroBase = gyroNow end
            local rel = gyroBase:Inverse() * gyroNow
            local rx, ry, rz = rel:ToEulerAnglesYXZ()
            if math.abs(rx) > GYRO_ANGLE_MAX or math.abs(ry) > GYRO_ANGLE_MAX or math.abs(rz) > GYRO_ANGLE_MAX then
                gyroBase = gyroNow
                rx, ry, rz = 0, 0, 0
            end
            rx = math.clamp(rx, -GYRO_ROT_MAX, GYRO_ROT_MAX)
            ry = math.clamp(ry, -GYRO_ROT_MAX, GYRO_ROT_MAX)
            rz = math.clamp(rz, -GYRO_ROT_MAX, GYRO_ROT_MAX)
            local rL, pL, zL = rx, ry, rz
            local rR, pR, zR = rx, ry, rz
            if gyroVRMode then
                if not gyroVRHandOn then
                    rL, pL, zL = 0, 0, 0
                    rR, pR, zR = 0, 0, 0
                elseif gyroVRHand == "left" then rR, pR, zR = 0, 0, 0
                else rL, pL, zL = 0, 0, 0 end
            elseif gyroHand == "left" then rR, pR, zR = 0, 0, 0
            elseif gyroHand == "right" then rL, pL, zL = 0, 0, 0 end
            local rk = gyroVRMode and GYRO_VR_ROT_K or GYRO_ROT_K
            local targetRL = CFrame.fromEulerAnglesYXZ(rL * rk * GYRO_MIRROR_L, pL * rk * GYRO_MIRROR_L, zL * rk * GYRO_MIRROR_L)
            local targetRR = CFrame.fromEulerAnglesYXZ(rR * rk * GYRO_MIRROR_R * -1, pR * rk * GYRO_MIRROR_R * -1, zR * rk * GYRO_MIRROR_R * -1)
            local aR = 1 - math.exp(-GYRO_ROT_SMOOTH * dt)
            gyroRotL = gyroRotL:Lerp(targetRL, aR)
            gyroRotR = gyroRotR:Lerp(targetRR, aR)
            local pk = gyroVRMode and GYRO_VR_POS_K or GYRO_POS_K
            local posMax = gyroVRMode and GYRO_VR_POS_MAX or GYRO_POS_MAX
            local targetGyroL = Vector3.new(-pL * pk * GYRO_MIRROR_L, zL * pk * GYRO_MIRROR_L * 0.6, -rL * pk * 0.4)
            local targetGyroR = Vector3.new(-pR * pk * GYRO_MIRROR_R, zR * pk * GYRO_MIRROR_R * 0.6, -rR * pk * 0.4)
            if targetGyroL.Magnitude > posMax then targetGyroL = targetGyroL.Unit * posMax end
            if targetGyroR.Magnitude > posMax then targetGyroR = targetGyroR.Unit * posMax end
            local aP = 1 - math.exp(-GYRO_ROT_SMOOTH * dt)
            gyroPosL = gyroPosL:Lerp(targetGyroL, aP)
            gyroPosR = gyroPosR:Lerp(targetGyroR, aP)

            if gyroVRMode and gyroVRHeadOn then
                if not headGyroBase or not headBaseYaw then
                    headGyroBase = gyroNow
                    headBaseYaw = yaw
                    headBasePitch = pitch
                end
                local hRel = headGyroBase:Inverse() * gyroNow
                local hx, hy, hz = hRel:ToEulerAnglesYXZ()
                if math.abs(hx) > GYRO_VR_HEAD_MAX or math.abs(hy) > GYRO_VR_HEAD_MAX or math.abs(hz) > GYRO_VR_HEAD_MAX then
                    headGyroBase = gyroNow
                    headBaseYaw = yaw
                    headBasePitch = pitch
                    hx, hy, hz = 0, 0, 0
                end
                yaw = headBaseYaw + hy * GYRO_VR_HEAD_K * GYRO_VR_HEAD_YAW_SIGN
                pitch = math.clamp(headBasePitch + hx * GYRO_VR_HEAD_K * GYRO_VR_HEAD_PITCH_SIGN, -1.45, 1.45)
            end
        else
            local aR = math.min(dt * 6, 1)
            gyroRotL = gyroRotL:Lerp(CFrame.new(), aR)
            gyroRotR = gyroRotR:Lerp(CFrame.new(), aR)
            gyroPosL = gyroPosL:Lerp(Vector3.zero, aR)
            gyroPosR = gyroPosR:Lerp(Vector3.zero, aR)
        end

        local rot = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
        local hs = cam.HeadScale; if hs <= 1 then hs = S.scale * 6 end
        local spd = (10 + S.scale * 4) * hs * S.moveK * S.speedMult

        local mv = Vector3.zero
        if keys[Enum.KeyCode.W] then mv += Vector3.new(0,0,-1) end
        if keys[Enum.KeyCode.S] then mv += Vector3.new(0,0, 1) end
        if keys[Enum.KeyCode.A] then mv += Vector3.new(-1,0,0) end
        if keys[Enum.KeyCode.D] then mv += Vector3.new( 1,0,0) end
        if keys[Enum.KeyCode.Space] then mv += Vector3.new(0, 1,0) end
        if keys[Enum.KeyCode.LeftShift] then mv += Vector3.new(0,-1,0) end
        if mv.Magnitude > 0 then mv = mv.Unit end

        local targetVel = mv * spd
        if moveSmoothOn then
            local isAccel = mv.Magnitude > 0.01
            local rate = isAccel and MOVE_ACCEL or MOVE_DECEL
            local a = 1 - math.exp(-rate * dt)
            moveVel = moveVel:Lerp(targetVel, a)
            if not isAccel and moveVel.Magnitude < MOVE_MIN_SPEED then
                moveVel = Vector3.zero
            end
        else
            moveVel = targetVel
        end

        if moveVel.Magnitude > 0 then
            camPos = camPos + (rot * moveVel) * dt
        end

        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = CFrame.new(camPos) * rot
        if Input then
            Input.directionLateral = Vector2.zero
            Input.directionVertical = 0
            Input.turnDirection = 0
        end
    end)

