                -- Mobile touch look
                ----------------------------------------------------------------

                local touchLook = false
                local lastTouch = Vector2.zero

                local touchSens = 0.005

                local function isInsideControl(pos)

                    local controls = {
                        dpad,
                        vert,
                        grab,
                        func,
                        shakeBtn,
                        handBtn,
                        gyroBtn,
                        gyroHandBtn,
                        timeBox,
                        waveBtn,
                        clapBtn,
                        startleBtn,
                        flexBtn,
                        throwBtn,
                        punchBtn,
                        blockBtn
                    }

                    for _, control in ipairs(controls) do

                        local p =
                            control.AbsolutePosition

                        local s =
                            control.AbsoluteSize

                        if pos.X >= p.X
                            and pos.X <= p.X + s.X
                            and pos.Y >= p.Y
                            and pos.Y <= p.Y + s.Y then

                            return true
                        end
                    end

                    return false
                end

                UIS.TouchStarted:Connect(function(i)

                    local pos = i.Position

                    if isInsideControl(pos) then
                        return
                    end

                    local viewport =
                        workspace.CurrentCamera
                            .ViewportSize

                    if pos.X
                        > viewport.X * 0.5 then

                        if pos.Y
                            < viewport.Y * 0.85
                            and pos.Y
                            > viewport.Y * 0.15 then

                            touchLook = true
                            lastTouch = pos
                        end
                    end
                end)

                UIS.TouchMoved:Connect(function(i)

                    if touchLook then

                        local delta =
                            i.Position
                            - lastTouch

                        yaw =
                            yaw
                            - delta.X * touchSens

                        pitch =
                            math.clamp(
                                pitch
                                - delta.Y * touchSens,
                                -1.45,
                                1.45
                            )

                        lastTouch =
                            i.Position
                    end
                end)

                UIS.TouchEnded:Connect(function()

                    touchLook = false
                end)
            end)

