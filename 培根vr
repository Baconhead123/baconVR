            local function createHorizontalSlider(parent, name, posX, posY, minVal, maxVal, initVal, updateFunc)
                local track = Instance.new("Frame")
                track.Name = name.."Track"
                track.Size = UDim2.fromScale(0.14, 0.03)
                track.Position = UDim2.fromScale(posX, posY)
                track.AnchorPoint = Vector2.new(0.5, 0.5)
                track.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
                track.BackgroundTransparency = 0.5
                track.BorderSizePixel = 0
                Instance.new("UICorner", track).CornerRadius = UDim.new(0, 4)
                track.Parent = parent
                local thumb = Instance.new("Frame")
                thumb.Name = name.."Thumb"
                thumb.Size = UDim2.fromScale(0.03, 0.025)
                thumb.AnchorPoint = Vector2.new(0.5, 0.5)
                thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                thumb.BackgroundTransparency = 0.3
                thumb.BorderSizePixel = 0
                Instance.new("UICorner", thumb).CornerRadius = UDim.new(0, 4)
                thumb.Parent = track
                local slider = { track = track, thumb = thumb, min = minVal, max = maxVal, update = updateFunc }
                local ratio = (initVal - minVal) / (maxVal - minVal)
                local thumbOffset = (ratio - 0.5) * (track.AbsoluteSize.X - thumb.AbsoluteSize.X)
                thumb.Position = UDim2.fromOffset(thumbOffset, 0) + UDim2.fromScale(0.5, 0.5)
                table.insert(sliders, slider)
                regHide(track)
                return slider
            end

