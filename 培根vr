            local function findSliderAt(pos)
                for _, slider in ipairs(sliders) do
                    local track = slider.track
                    if track.Visible then
                        local absPos = track.AbsolutePosition
                        local absSize = track.AbsoluteSize
                        if pos.X >= absPos.X and pos.X <= absPos.X + absSize.X
                            and pos.Y >= absPos.Y and pos.Y <= absPos.Y + absSize.Y then
                            return slider
                        end
                    end
                end
                return nil
            end
            local function updateHorizontalSlider(slider, touchPos)
                local track = slider.track
                local absPos = track.AbsolutePosition
                local absSize = track.AbsoluteSize
                local thumbSize = slider.thumb.AbsoluteSize
                local minX = absPos.X + thumbSize.X / 2
                local maxX = absPos.X + absSize.X - thumbSize.X / 2
                local clampedX = math.clamp(touchPos.X, minX, maxX)
                local ratio = (clampedX - minX) / (maxX - minX)
                local value = slider.min + (slider.max - slider.min) * ratio
                value = math.clamp(value, slider.min, slider.max)
                local thumbX = (ratio - 0.5) * (absSize.X - thumbSize.X)
                slider.thumb.Position = UDim2.fromOffset(thumbX, 0) + UDim2.fromScale(0.5, 0.5)
                slider.update(value)
            end
            local function updateVerticalSlider(slider, touchPos)
                local track = slider.track
                local absPos = track.AbsolutePosition
                local absSize = track.AbsoluteSize
                local thumbSize = slider.thumb.AbsoluteSize
                local minY = absPos.Y + thumbSize.Y / 2
                local maxY = absPos.Y + absSize.Y - thumbSize.Y / 2
                local clampedY = math.clamp(touchPos.Y, minY, maxY)
                local ratio = 1 - (clampedY - minY) / (maxY - minY)
                local value = slider.min + (slider.max - slider.min) * ratio
                value = math.clamp(value, slider.min, slider.max)
                local thumbY = (0.5 - ratio) * (absSize.Y - thumbSize.Y)
                slider.thumb.Position = UDim2.fromOffset(0, thumbY) + UDim2.fromScale(0.5, 0.5)
                slider.update(value)
            end

