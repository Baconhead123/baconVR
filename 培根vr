                    -- Grab radius
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.LeftBracket then

                        S.grabRadiusMult =
                            math.clamp(
                                S.grabRadiusMult - 0.1,
                                0.1,
                                10
                            )
                    end

                    if io.KeyCode
                        == Enum.KeyCode.RightBracket then

                        S.grabRadiusMult =
                            math.clamp(
                                S.grabRadiusMult + 0.1,
                                0.1,
                                10
                            )
                    end

                    --------------------------------------------------------
                    -- Speed
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.Semicolon then

                        S.speedMult =
                            math.clamp(
                                S.speedMult - 0.1,
                                0.1,
                                10
                            )
                    end

                    if io.KeyCode
                        == Enum.KeyCode.Quote then

                        S.speedMult =
                            math.clamp(
                                S.speedMult + 0.1,
                                0.1,
                                10
                            )
                    end

                    --------------------------------------------------------
                    -- Grab mode
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.G then

                        S.toggleGrabMode =
                            not S.toggleGrabMode
                    end

                    --------------------------------------------------------
                    -- Actions
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.H then

                        clapStartTime =
                            os.clock()
                    end

                    if io.KeyCode
                        == Enum.KeyCode.J then

                        startleStartTime =
                            os.clock()
                    end

                    if io.KeyCode
                        == Enum.KeyCode.K then

                        flexStartTime =
                            os.clock()
                    end

                    if io.KeyCode
                        == Enum.KeyCode.Z then

                        punchStartTime =
                            os.clock()
                    end

                    if io.KeyCode
                        == Enum.KeyCode.X then

                        blockStartTime =
                            os.clock()
                    end

                    if io.KeyCode
                        == Enum.KeyCode.T then

                        doThrow()
                    end

                    --------------------------------------------------------
                    -- Shake
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.Y then

                        if shakeMode then
                            stopShakeMode()
                        else
                            startShakeMode()
                        end
                    end

                    --------------------------------------------------------
                    -- One/two hand
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.U then

                        shakeBothHands =
                            not shakeBothHands
                    end

                    --------------------------------------------------------
                    -- Gyroscope ON/OFF
                    -- N
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.N then

                        toggleGyro()
                    end

                    --------------------------------------------------------
                    -- Gyroscope LEFT/RIGHT
                    -- M
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.M then

                        switchGyroHand()
                    end

                    --------------------------------------------------------
                    -- Right pinch
                    --------------------------------------------------------

                    if Input
                        and io.KeyCode
                            == Enum.KeyCode.E then

                        if S.toggleGrabMode then

