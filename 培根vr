                    -- Camera
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.LeftAlt then

                        setLook(not S.look)
                    end

                    --------------------------------------------------------
                    -- Scale
                    --------------------------------------------------------

                    if io.KeyCode
                        == Enum.KeyCode.Equals then

                        setScale(
                            S.scale + 1
