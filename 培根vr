                                Input.lThumb = 0
                            end

                        else

                            Input.lIndex = 1
                            Input.lFist = 0
                            Input.lThumb = 0
                        end
                    end

                ------------------------------------------------------------
                -- Mouse
                ------------------------------------------------------------

                elseif io.UserInputType
                    == Enum.UserInputType.MouseButton1 then

                    if Input then

                        if S.toggleGrabMode then

                            Input.rFist =
                                Input.rFist == 1
                                and 0
