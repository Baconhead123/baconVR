                            - shakeTargetStart
                            >= SHAKE_DURATION then

                            shakeIndex =
                                shakeIndex + 1

                            if shakeIndex
                                > #shakeTargetList then

                                shakeTargetList =
                                    getShakeTargets()

                                shakeIndex = 1

                                if #shakeTargetList == 0 then

                                    shakeMode = false

                                    break
