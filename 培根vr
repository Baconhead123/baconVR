            ----------------------------------------------------------------

            local function setScale(n)

                n = math.clamp(
                    n,
                    0.1,
                    100
                )

                S.scale = n

                if scaleVal then

                    pcall(function()

                        scaleVal.Value =
                            n / 10
                    end)
                end

                if vrm
                    and vrm.DataManager
                    and vrm.DataManager.SettingsManager then

                    pcall(function()

                        vrm.DataManager
                            .SettingsManager
                            :SetValue(
                                "vrscale",
                                n
                            )
                    end)
                end
            end

